    },
    "e50343ab-88ad-4115-b14c-920dcf0b2a3e": {
      "id": "e50343ab-88ad-4115-b14c-920dcf0b2a3e",
      "name": "Food basics: mostly whole foods\u2014lean protein, veggies, fruit, whole grains, and healthy fats. Aim for about 1.6\u20132.2 grams of protein per kilogram of body weight each day.",
      "type": "AgentStateBody",
      "owner": "37d085c2-b487-433e-8918-6057cd39708f",
      "bounds": {
        "x": 210,
        "y": 140,
        "width": 159,
        "height": 30
      },
      "replyType": "text"
    },
    "a6bc1afb-2bd8-487e-b5d7-55896513f983": {
      "id": "a6bc1afb-2bd8-487e-b5d7-55896513f983",
      "name": "Match your calories to your goal: a little more to gain muscle, a little less to lose fat, or the same to keep your weight.",
      "type": "AgentStateBody",
      "owner": "37d085c2-b487-433e-8918-6057cd39708f",
      "bounds": {
        "x": 210,
        "y": 140,
        "width": 159,
        "height": 30
      },
      "replyType": "text"
    },
    "3c89d06f-1062-4757-bfe3-fa1997f305cc": {
      "id": "3c89d06f-1062-4757-bfe3-fa1997f305cc",
      "name": "Carbs fuel your training. Fats support your hormones.",
      "type": "AgentStateBody",
      "owner": "37d085c2-b487-433e-8918-6057cd39708f",
      "bounds": {
        "x": 210,
        "y": 140,
        "width": 159,
        "height": 30
      },
      "replyType": "text"
    },
    "ee8e6d5e-ecdf-47b8-9f8c-33edd60aaeb8": {
      "id": "ee8e6d5e-ecdf-47b8-9f8c-33edd60aaeb8",
      "name": "Drink plenty of water. Go easy on ultra-processed foods and alcohol.",
      "type": "AgentStateBody",
      "owner": "37d085c2-b487-433e-8918-6057cd39708f",
      "bounds": {
        "x": 210,
        "y": 140,
