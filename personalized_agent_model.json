    "4630a14e-b854-4346-b575-71735694af0a": {
      "id": "4630a14e-b854-4346-b575-71735694af0a",
      "name": "Focus on the big, heavy lifts\u2014squats, deadlifts, bench, overhead press, and rows. That\u2019s how you build muscle.",
      "type": "AgentStateBody",
      "owner": "ad192002-4a69-4647-878e-ed3117a846c1",
      "bounds": {
        "x": -280,
        "y": 140,
        "width": 159,
        "height": 30
      },
      "replyType": "text"
    },
    "539fea32-b50d-4b6d-b4f9-a71361ac1c6d": {
      "id": "539fea32-b50d-4b6d-b4f9-a71361ac1c6d",
      "name": "Train 3\u20135 days a week. Nudge the weight up over time. Eat enough protein and calories to grow.",
      "type": "AgentStateBody",
      "owner": "ad192002-4a69-4647-878e-ed3117a846c1",
      "bounds": {
        "x": -280,
        "y": 140,
        "width": 159,
        "height": 30
      },
      "replyType": "text"
    },
    "a1665e10-edbc-4a83-a291-52136b2c1347": {
      "id": "a1665e10-edbc-4a83-a291-52136b2c1347",
      "name": "Get enough sleep and stay consistent. Muscle grows from steady work over time.",
      "type": "AgentStateBody",
      "owner": "ad192002-4a69-4647-878e-ed3117a846c1",
      "bounds": {
        "x": -280,
        "y": 140,
        "width": 159,
        "height": 30
      },
